QMainWindow, QDialog {
    background: #f5f7fa;
}

QLabel {
    color: #1f2937;
    font-size: 14px;
}

#title {
    font-size: 26px;
    font-weight: 700;
    color: #111827;
}

#subtitle {
    font-size: 13px;
    color: #6b7280;
}

#selectionFrame {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
}

#fieldLabel {
    min-width: 120px;
    font-weight: 600;
    color: #374151;
}

QComboBox {
    min-height: 38px;
    padding: 0 12px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    background: white;
    color: #111827;
}

QComboBox QAbstractItemView {
    background: white;
    color: #111827;
    selection-background-color: #e5e7eb;
    selection-color: #111827;
}

QComboBox:hover {
    border: 1px solid #9ca3af;
}

QComboBox:focus {
    border: 1px solid #6b7280;
}

QPushButton#websitesButton,
QPushButton#analyzeButton,
QPushButton#fetchButton,
QPushButton#stopFetchButton,
QDialog QPushButton {
    min-width: 140px;
    min-height: 40px;
    padding: 0 22px;
    border: none;
    border-radius: 6px;
    background: #1f2937;
    color: white;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#websitesButton:hover,
QPushButton#analyzeButton:hover,
QPushButton#fetchButton:hover,
QPushButton#stopFetchButton:hover,
QDialog QPushButton:hover {
    background: #374151;
}

QPushButton#websitesButton:pressed,
QPushButton#analyzeButton:pressed,
QPushButton#fetchButton:pressed,
QPushButton#stopFetchButton:pressed,
QDialog QPushButton:pressed {
    background: #111827;
}

/* Adds a greyed-out look when buttons are disabled */
QPushButton:disabled {
    background: #9ca3af;
    color: #f3f4f6;
}

#panel {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
}

#panelTitle {
    font-size: 16px;
    font-weight: 700;
    color: #111827;
    padding-bottom: 6px;
}

#findingsOutput,
#logOutput {
    padding: 12px;
    background: #f9fafb;
    border: 1px solid #eef0f2;
    border-radius: 6px;
    color: #4b5563;
}

QStatusBar {
    color: #6b7280;
}

/* --- New Styles for the Websites History Popup --- */
QTableWidget {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    gridline-color: #eef0f2;
    color: #4b5563;
    font-size: 13px;
}

QHeaderView::section {
    background-color: #f9fafb;
    color: #374151;
    font-weight: 600;
    padding: 8px;
    border: none;
    border-right: 1px solid #e5e7eb;
    border-bottom: 1px solid #e5e7eb;
}

QTableWidget::item {
    padding: 4px;
    border-bottom: 1px solid #eef0f2;
}

QTableWidget::item:selected {
    background-color: #e5e7eb;
    color: #111827;
}